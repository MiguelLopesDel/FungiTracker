{
  "stryker-config": {
    "project": "EcoMyceliumTracker.csproj",
    "test-projects": [
      "tests/EcoMyceliumTracker.UnitTests/EcoMyceliumTracker.UnitTests.csproj"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "mutate": [
      "Application/**/*.cs",
      "Validation/**/*.cs"
    ],
    "thresholds": {
      "high": 90,
      "low": 75,
      "break": 70
    }
  }
}
