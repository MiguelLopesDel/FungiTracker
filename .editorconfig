root = true

[*.{cs,csproj,sln}]
charset = utf-8-bom
end_of_line = lf
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

[*.{json,yml,yaml,md,http,sql}]
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
