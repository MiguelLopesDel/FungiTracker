{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgresConnection": "Host=localhost;Database=myceliumTracker;Username=YOUR_USER;Password=YOUR_PASSWORD"
  },
  "Authentication": {
    "ApiKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Transfers": {
    "HighEnergyThresholdMg": 500
  },
  "Database": {
    "RunMigrations": true
  }
}
